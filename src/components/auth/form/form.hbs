<div class="form-wrapper">
    <form class="form-container {{formClass}}">
        <h2 class="form-container__title">{{title}}</h2>
        <div class="form-container__inputs">
            {{#each inputs}}
                {{> Input id=this.id type=this.type label=this.label inputClass="form-container__input"}}
            {{/each}}
        </div>
        <button type="submit" class="button form-container__button" data-link={{buttonLink}}>{{buttonText}}</button>
        {{> Link link}}
    </form>
</div>